# Keep real values in local .env / deployment secret settings only. Never commit .env.
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
TRUST_PROXY=0

# Transactional email API. Required in production for verification, invitations and password reset.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Supabase private Storage bucket. Service role key is backend-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_BUCKET=complytrack-private

# Malware scanning fails closed if not configured.
MALWARE_SCANNER_PROVIDER=
MALWARE_SCANNER_URL=
MALWARE_SCANNER_API_KEY=
MALWARE_SCANNER_TIMEOUT_MS=10000
